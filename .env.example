# Copy to .env and fill in values. Used by Flask, docker compose, MinIO, and RQ.

# --- MySQL (Flask app + docker compose mysql service) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=highschool

# --- Flask ---
FLASK_SECRET_KEY=change-me-in-production
FLASK_PORT=3000

# --- Microsoft Entra ID (optional "Sign in with Microsoft" on high school login) ---
# Names match the Entra app registration fields. Redirect_url must match the
# Flask route exactly (this app uses /auth/callback).
Client_id=
Value=
Redirect_url=http://localhost:3000/auth/callback
auth_url=https://login.microsoftonline.com/common
# Optional: space-separated scopes (do not include openid/profile/offline_access).
authorization=User.Read email
# Not used by the app (Azure's id for the secret, not the secret string):
# Secret_id=
# Also unused: Token, Connect

# App login password for seed users and make_test_login.py (default: 123123)
TEST_PASSWORD=123123

# --- Redis (RQ job queue; docker compose redis service) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- MinIO (object storage; docker compose minio service) ---
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in compose.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=aari-videos
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PRESIGNED_EXPIRY=3600

# Origins allowed to load presigned MinIO URLs (comma-separated).
MINIO_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- Deployment (Docker / Railway) ---
# Set to true behind Railway's HTTPS proxy (trusts X-Forwarded-* and uses secure cookies).
BEHIND_PROXY=false
# Load bootcamp.sql / highschool.sql on container start when those databases don't exist yet.
AUTO_INIT_DB=true
# Run the video transcode worker inside the web container.
RUN_WORKER=true
WEB_CONCURRENCY=2

# --- Video transcode (streaming.py) ---
TRANSCODE_TMP_DIR=/tmp/aari-transcode
TRANSCODE_QUEUE_TIMEOUT_SECONDS=20
TRANSCODE_JOB_TIMEOUT=10800
# Browser uploads are split into chunks of this size (keeps requests under proxy limits).
VIDEO_UPLOAD_CHUNK_BYTES=16777216
VIDEO_UPLOAD_MAX_BYTES=5368709120
