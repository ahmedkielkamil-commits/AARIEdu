# Copy to .env and fill in values. Used by Flask, docker compose, MinIO, and RQ.

# --- MySQL (Flask app + docker compose mysql service) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=robcourse

# --- Flask ---
FLASK_SECRET_KEY=change-me-in-production
FLASK_PORT=5000

# App login password for seed users and make_test_login.py (default: 123123)
TEST_PASSWORD=123123

# --- Redis (RQ job queue; docker compose redis service) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- MinIO (object storage; docker compose minio service) ---
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in compose.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=aari-videos
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PRESIGNED_EXPIRY=3600

# --- Video transcode (streaming.py) ---
TRANSCODE_TMP_DIR=/tmp/aari-transcode
TRANSCODE_QUEUE_TIMEOUT_SECONDS=20
TRANSCODE_JOB_TIMEOUT=3600
