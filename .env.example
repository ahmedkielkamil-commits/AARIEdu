# Copy to .env and fill in your MySQL Workbench credentials.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_workbench_password
MYSQL_DATABASE=robcourse
FLASK_SECRET_KEY=change-me-in-production

# App login password for seed users and make_test_login.py (default: 123123)
TEST_PASSWORD=123123
